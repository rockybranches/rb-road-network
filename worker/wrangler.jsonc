{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rb-road-network",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  // No public address yet. The API has no login of its own, so the
  // workers.dev address stays off until Cloudflare Access protects this
  // Worker (see "Deploying" in README.md). Preview addresses stay off.
  "workers_dev": false,
  "preview_urls": false,
  // The map page. Files here are served directly; every other path,
  // including all of /api, goes to the Worker.
  "assets": { "directory": "./public" },
  // The search is CPU-bound; the 10 ms free-plan limit cannot run it.
  "limits": { "cpu_ms": 60000 },
  // Which loaded dataset versions the Worker reads. New data is loaded under
  // a new label and switched here, so a reload never disturbs live queries.
  "vars": {
    "ROADS_DATASET": "osm-2026-02",
    "COUNTIES_DATASET": "tl-2016"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rb-road-network",
      "database_id": "fb2aeb0d-15fd-448a-b053-ecc3b4e2198a",
      "migrations_dir": "migrations"
    }
  ]
}
